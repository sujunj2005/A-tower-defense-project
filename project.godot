; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="TestMCP"
run/main_scene="res://scenes/core/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

AssetsManager="*res://scripts/managers/assets_manager.gd"
SceneManager="*res://scenes/scene_manager.tscn"
Global="*res://autoload/global.gd"
ConfigManager="*res://scripts/managers/config_manager.gd"
EraSystem="*res://scripts/logic/life_simulation/era_system.gd"
AgeSystem="*res://scripts/logic/life_simulation/age_system.gd"
EventSystem="*res://scripts/logic/life_simulation/event_system.gd"
AttributeSystem="*res://scripts/logic/life_simulation/attribute_system.gd"
TraitSystem="*res://scripts/logic/life_simulation/trait_system.gd"
EndingSystem="*res://scripts/logic/life_simulation/ending_system.gd"
GameState="*res://scripts/logic/game_state.gd"
SceneTransition="*res://scripts/logic/scene_transition.gd"
EconomySystem="*res://scripts/logic/tower_defense/economy_system.gd"
CurrencyManager="*res://scripts/logic/meta_progression/currency_manager.gd"
UnlockSystem="*res://scripts/logic/meta_progression/unlock_system.gd"
AchievementSystem="*res://scripts/logic/meta_progression/achievement_system.gd"
SaveSystem="*res://scripts/managers/save_system.gd"
TooltipManager="*res://scripts/ui/components/tooltip_manager.gd"
AttributeConfig="*res://scripts/logic/life_simulation/attribute_config.gd"
BattleRating="*res://scripts/logic/tower_defense/battle_rating.gd"
WaveManager="*res://scripts/logic/tower_defense/wave_manager.gd"
OptionSystem="*res://scripts/logic/life_simulation/option_system.gd"
I18nManager="*res://autoload/i18n_manager.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=768
window/stretch/mode="canvas_items"

[editor]

version="4.6"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg", "res://addons/gut/plugin.cfg")

[file_customization]

folder_colors={
"res://knowledge_base/": "green"
}

[internationalization]

locale/translations=["res://locale/translations.zh.translation", "res://locale/translations.en.translation"]
locale/fallback="zh"

# 攻击特效类型枚举定义
# 适用于防御塔攻击系统 V2.1

## 特效类型枚举
## 定义攻击命中后触发的特效效果
enum EffectType {
	NONE = 0,       # 无特效
	PIERCE = 1,     # 穿透：弹道可穿透多个目标（仅POSITION_FIXED可用）
	SPLASH = 2,     # AOE范围爆炸：对范围内敌人造成比例伤害
	SLOW = 3,       # 减速：降低目标移动速度
	DOT = 4,        # 持续伤害：每秒造成固定伤害
	KNOCKBACK = 5,  # 击退：将目标击退一定距离
	LIFESTEAL = 6   # 吸血：将伤害转化为自身生命值恢复
}

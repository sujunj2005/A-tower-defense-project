# 排除所有以.开头的文件夹
.*

# Godot 4 缓存文件夹（需要被忽略）
.godot/imported/
.godot/shader_cache/
.godot/scene_groups_cache.cfg
.godot/uid_cache.bin

# 默认忽略知识库新增文件，保留已跟踪的资料
/knowledge_base/*
docs/
node_modules/
stable/
addons/
images/
xlsx/
w64devkit/
get-shit-done/

# 排除测试报告文件
测试报告_暂停菜单功能.md
主菜单与暂停菜单功能测试报告.md
gsd-file-manifest.json

# 其他常见忽略规则
*.import
/locale/translations.en.translation
/locale/translations.zh.translation
*.pid
*.pot
*.mo
*.mdb
*.vscode/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.md

# Reproducible Godot development and CI entry points
!/README.md
/AGENTS.md
/TODO.md
/.codex/
/.agents/
/.trae/
!/.gutconfig_all.json
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/godot-tests.yml

# 项目检出需要包含知识库入口、项目规范及其余项目资料
!/knowledge_base/index.md
!/knowledge_base/outline/
!/knowledge_base/outline/*.md
!/knowledge_base/base/
/knowledge_base/base/*
!/knowledge_base/base/*.md
/knowledge_base/base/health-check-report.md
/knowledge_base/base/log.md
!/knowledge_base/base/practical-experiences/
/knowledge_base/base/practical-experiences/*
!/knowledge_base/base/practical-experiences/best-practices/
!/knowledge_base/base/practical-experiences/best-practices/*.md
!/knowledge_base/base/practical-experiences/pitfall-cases/
!/knowledge_base/base/practical-experiences/pitfall-cases/*.md

